     channels)

    (no-recovery-msgs-in-channel-p
     new-channel))

   (no-recovery-msgs-for-dsts-p
    scan-src
    dsts
    (s dst
       (s src
          new-channel
          (g dst channels))
       channels)))

  :hints
  (("Goal"
