    (cut-meta-imp-consistent-p m st)

    (good-cut-meta-p m)

    (good-state-p st)

    (legal-input-sequencep
     st
     (list input-i input-j))

    (cl-checkpoint-body-input-p
     input-i)

    (cl-checkpoint-body-input-p
     input-j)

    ;; INPUT-I is no-recovery in ST.
    (no-recovery-step-p
     input-i
     st)

    ;; INPUT-J is no-recovery after INPUT-I.
