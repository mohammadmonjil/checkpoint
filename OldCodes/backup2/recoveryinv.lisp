     dsts
     channels)

    (not
     (equal
      (msg-type msg)
      :recovery)))

   (no-recovery-msgs-for-dsts-p
    scan-src
    dsts
    (s dst
       (s src
          (snoc
           (channel-state
            src
            dst
            channels)
           msg)
          (g dst channels))
       channels)))

  :hints
  (("Goal"

    :cases
    ((equal scan-src src)
     (equal (first dsts) dst)))))


