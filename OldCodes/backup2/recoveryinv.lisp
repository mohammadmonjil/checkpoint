(defthm no-recovery-step-p-preserves-no-proc-recovering
  (implies
   (and
    (not
     (any-proc-recovering-p
      (proc-ids st)
      (procs st)))

    (no-recovery-step-p
     input
     st))

   (not
    (any-proc-recovering-p
     (proc-ids st)
     (procs
      (system-step st input))))))



