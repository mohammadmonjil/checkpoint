(defthm
  cut-markers-in-transit-for-srcs-p-preserved-by-remove-message-when-i-already-cut

  (implies
   (and
    (cut-markers-in-transit-for-srcs-p
     pids
     target-sid
     m
     procs
     channels)

    (not
     (memberp i
              (cm-cut-not-taken m))))

   (cut-markers-in-transit-for-srcs-p
    pids
    target-sid
    m
    procs
    (remove-message-from-channel
     j i channels)))

  :hints
  (("Goal"
    :induct
    (cut-markers-in-transit-for-srcs-p
