;; If INPUT-I is a RECEIVE and is a NO-RECOVERY step in ST,
;; then moving a checkpoint-body INPUT-J from another process
;; before INPUT-I preserves that NO-RECOVERY status.
;;
;; The two processes are different, so INPUT-J cannot consume
;; from INPUT-I's receive channel.  Checkpoint-body steps may
;; only leave that channel unchanged or append to its tail.
;; Hence its existing head message is unchanged.
;; ------------------------------------------------------------

(defthm
  no-recovery-receive-preserved-after-checkpoint-body-step

  (implies
   (and
    (equal
     (ttype input-i)
     :receive)

    (cl-checkpoint-body-input-p
     input-j)

    (not
     (equal
      (pid input-i)
      (pid input-j)))

    (consp
     (channel-state
      (sender input-i)
      (pid input-i)
      (channels st)))

    (no-recovery-step-p
     input-i
     st)

    ;; INPUT-J itself must not introduce recovery.
    (no-recovery-step-p
     input-j
     st))

   (no-recovery-step-p
    input-i
    (system-step st input-j)))

  :hints
  (("Goal"
    :in-theory
    (e/d
     (no-recovery-step-p)
     (system-step
      get-msg-from-channel
      remove-message-from-channel)))))

