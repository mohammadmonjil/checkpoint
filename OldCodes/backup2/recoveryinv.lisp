     input-j
     (system-step st input-i))

    ;; INPUT-I is POST.
    (not
     (cm-cut-not-taken-p
      m
      (pid input-i)))

    ;; INPUT-J is PRE after INPUT-I.
    (cm-cut-not-taken-p
     (process-cut-step input-i st m)
