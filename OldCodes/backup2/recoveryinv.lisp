;; metadata/implementation facts needed to interpret the cut
;; status correctly.
;; ------------------------------------------------------------

(defthm cl-post-pre-two-imp-inputs-swappable-p
  (let*
      (
       ;; (st-after-i
       ;;  (system-step
       ;;   st
       ;;   input-i))

       (m-after-i
        (process-cut-step
         input-i
         st
         m)))

    (implies
     (and
      ;; Current implementation/cut invariants.
      (cut-markers-in-transit-p
       m
       st)

      (cut-meta-imp-consistent-p
       m
       st)

      (good-cut-meta-p m)

      (good-state-p st)

      ;; INPUT-I ; INPUT-J is the actual legal execution order.
      (legal-input-sequencep
       st
       (list input-i input-j))

