      (cl-checkpoint-body-input-p
       input-i)

      (cl-checkpoint-body-input-p
       input-j)

      ;; No recovery behavior occurs in this pair.
      (no-recovery-segment-p
       (list input-i input-j)
       st)

      ;; INPUT-I is POST-CUT.
      (not
       (cm-cut-not-taken-p
        m
        (pid input-i)))

      ;; INPUT-J is still PRE-CUT immediately before it executes.
      (cm-cut-not-taken-p
       m-after-i
       (pid input-j)))

     (cl-two-imp-inputs-swappable-p
      st
      input-i
      input-j)))
