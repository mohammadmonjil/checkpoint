;; Spec messages consumed by replaying an input list.
;;
;; (defun spec-consumed-msgs (st inputs) ...)

;; Per-channel predicate: metadata :MSGS-AFTER-CUT equals what spec consumes
;; when it runs that one row of :INPUTS-AFTER-CUT.

(defun cm-spec-consumed-msgs-match-p (i j m spec-cut-st)
  (equal
   (cm-after-cut-msg-get m i j)
   (spec-consumed-msgs
    spec-cut-st
    (cm-after-cut-get m i j))))

;; Neighbor-row predicate.

(defun cm-spec-consumed-msgs-match-for-nbrs-p
    (i nbrs m spec-cut-st)
  (if (endp nbrs)
      t
    (and
     (cm-spec-consumed-msgs-match-p
      i (car nbrs) m spec-cut-st)
     (cm-spec-consumed-msgs-match-for-nbrs-p
      i (cdr nbrs) m spec-cut-st))))

