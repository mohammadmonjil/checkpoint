;; 1. Before-cut local-state match
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Predicate: spec local state after CM-INPUTS-BEFORE-CUT equals current
;; implementation local state for process i.
;;
;; This is the invariant preserved while i has not yet taken the cut.

(defun cut-scan-spec-imp-local-match-p
    (i m imp-st spec-start-st)
  (equal
   (local-state
    (g i
       (procs
        (run-spec spec-start-st
                  (cm-inputs-before-cut m)))))
   (local-state
    (g i
       (procs imp-st)))))

