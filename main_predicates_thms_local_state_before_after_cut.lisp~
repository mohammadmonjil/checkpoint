;; 2. Cut-taking step installs the correct snapshot local state
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Predicate: process i takes its local cut during this one step.

(defun cut-scan-proc-takes-cut-step-p (i input st m)
  (and
   (memberp i (cm-cut-not-taken m))
   (not
    (memberp i
             (cm-cut-not-taken
              (process-cut-step input st m))))))

;; Predicate: the saved implementation snapshot local state equals the spec
;; local state after CM-INPUTS-BEFORE-CUT.

(defun cut-scan-spec-snapshot-local-match-p
    (i sid m imp-st spec-start-st)
  (equal
   (local-state
    (g i
       (procs
        (run-spec spec-start-st
                  (cm-inputs-before-cut m)))))
   (snapshot-local-snap-shot
    (snapshot-entry sid
                    (g i (procs imp-st))))))

;; Main theorem: when i takes the cut on a first marker, the implementation
;; snapshot stores exactly the before-cut spec local state.
;;
;; (defthm cut-scan-spec-local-match-implies-snapshot-local-match-when-cut-taken-step ...)

;; Later replay theorem uses SPEC-IMP-SNAPSHOT-LOCAL-MATCH-P, so this bridge is
;; usually useful.

(defun spec-imp-snapshot-local-match-p
    (i sid imp-st spec-st)
  (equal
   (snapshot-local-snap-shot
    (snapshot-entry sid
                    (g i (procs imp-st))))
   (local-state
    (g i
       (procs spec-st)))))

(defthm cut-scan-spec-snapshot-local-match-p-implies-spec-imp-snapshot-local-match-p
  (implies
   (cut-scan-spec-snapshot-local-match-p
    i sid m imp-st spec-start-st)
   (spec-imp-snapshot-local-match-p
    i sid
    imp-st
    (run-spec spec-start-st
              (cm-inputs-before-cut m))))
  :hints
  (("Goal"
    :in-theory
    (enable cut-scan-spec-snapshot-local-match-p
            spec-imp-snapshot-local-match-p))))


