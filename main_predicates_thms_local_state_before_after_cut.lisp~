;; 7. Pointwise message match -> sequential message match
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Sequential version of implementation-snapshot/spec message match.
;; Each next neighbor is checked after spec runs the previous channel row.

(defun imp-snapshot-spec-msgs-match-for-nbrs-seq-p
    (i nbrs sid m st spec-cut-st)
  (if (endp nbrs)
      t
    (let* ((j  (car nbrs))
           (xs (cm-after-cut-get m i j)))
      (and
       (imp-snapshot-spec-msgs-match-p
        i j sid m st spec-cut-st)
       (imp-snapshot-spec-msgs-match-for-nbrs-seq-p
        i
        (cdr nbrs)
        sid
        m
        st
        (run-spec spec-cut-st xs))))))

