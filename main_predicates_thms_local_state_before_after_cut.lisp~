;; 9. Final theorem shape: before-cut + after-cut in one RUN-SPEC
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Existing append theorem:
;;
;; (defthm run-spec-of-append
;;   (equal
;;    (run-spec st (append xs ys))
;;    (run-spec
;;     (run-spec st xs)
;;     ys)))

;; This is the exact final shape you described:
;; running spec on inputs-before-cut and then inputs-after-cut for one process
;; gives the same local state as replaying the implementation snapshot.

(defthm imp-snapshot-replay-local-state-equals-run-spec-before-cut-then-after-cut
  (implies
   (and
    ;; Local snapshot equals spec after CM-INPUTS-BEFORE-CUT.
    ;; Usually obtained from:
    ;;   cut-scan-spec-local-match-implies-snapshot-local-match-when-cut-taken-step
    ;; plus the bridge in Section 2.
    (spec-imp-snapshot-local-match-p
     i sid
     imp-st
     (run-spec spec-start-st
               (cm-inputs-before-cut m)))

    ;; Snapshot channel messages equal spec consumed messages when replaying
    ;; the after-cut input rows from the cut spec state.
    ;; Usually obtained from:
    ;;   imp-snapshot-spec-msgs-match-for-nbrs-p-from-cm-bridges
    ;; using the CM/spec and CM/implementation segment theorems.
    (imp-snapshot-spec-msgs-match-for-nbrs-p
     i nbrs-from sid m imp-st
     (run-spec spec-start-st
               (cm-inputs-before-cut m)))

    ;; Rows in :INPUTS-AFTER-CUT are well-formed receives grouped by source.
    (after-cut-for-proc-well-formed-p
     i nbrs-from m)

    ;; Needed for disjoint channel replay order.
    (uniquep nbrs-from))

   (let* ((p             (g i (g :procs imp-st)))
          (entry         (snapshot-entry sid p))
          (snap-local    (snapshot-local-snap-shot entry))
          (channel-snaps (snapshot-channel-snapshots entry)))
     (equal
      (replay-channel-snapshots
       snap-local
       channel-snaps
       nbrs-from)

      (local-state
       (g i
          (procs
           (run-spec
            spec-start-st
            (append
             (cm-inputs-before-cut m)
             (replay-inputs-for-one-proc
              i nbrs-from m))))))))))
  :hints
  (("Goal"
    :use
    ((:instance
      imp-snapshot-replay-local-state-equals-spec-replay-inputs-for-one-proc
      (i i)
      (sid sid)
      (imp-st imp-st)
      (spec-cut-st
       (run-spec spec-start-st
                 (cm-inputs-before-cut m)))
      (nbrs-from nbrs-from)
      (m m)))
    :in-theory
    (e/d
     (run-spec-of-append)
     (imp-snapshot-replay-local-state-equals-spec-replay-inputs-for-one-proc
      replay-channel-snapshots
      replay-inputs-for-one-proc
      run-spec)))))


