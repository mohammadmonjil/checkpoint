(defthm good-state-p-of-step-rcv
  (implies
   (and
    (good-state-p st)
    (memberp i (proc-ids st))
    (memberp j (proc-ids st))
    (memberp j (nbrs-from (g i (procs st))))
    ;; The channel head is one of the handled message types.
    (or (equal (msg-type (get-msg-from-channel j i (channels st))) :normal)
        (equal (msg-type (get-msg-from-channel j i (channels st))) :marker)
        (equal (msg-type (get-msg-from-channel j i (channels st))) :recovery))
    ;; Marker-side condition needed by handle-marker-msg:
    ;; if this is a marker at receiver i, then the sid is known
    ;; somewhere in the system.
    (implies
     (equal (msg-type (get-msg-from-channel j i (channels st))) :marker)
     (some-proc-has-snapshot-id-p
      (sid (get-msg-from-channel j i (channels st)))
      (proc-ids st)
      (procs st)))
    ;; Recovery-side condition needed by handle-recovery-msg:
    ;; then the recovery sid must already be known by receiver i.
    (implies
     (equal (msg-type (get-msg-from-channel j i (channels st))) :recovery)
     (memberp
      (sid (get-msg-from-channel j i (channels st)))
      (snapshot-ids (g i (procs st))))))
   (good-state-p
    (step-rcv st i j)))
  :hints
  (("Goal"
    :cases
    ((equal (msg-type (get-msg-from-channel j i (channels st))) :normal)
     (equal (msg-type (get-msg-from-channel j i (channels st))) :marker)
     (equal (msg-type (get-msg-from-channel j i (channels st))) :recovery))
    :in-theory
    (disable good-state-p
             good-proc-p
             get-msg-from-channel
	     some-proc-has-snapshot-id-p
             handle-normal-msg
             handle-marker-msg
             handle-recovery-msg))))
