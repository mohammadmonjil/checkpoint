;; 9. Receive-level theorem:
;;    if step-rcv dispatches to the normal-message core path, then full
;;    implementation/spec equivalence is preserved.
;;
;; The extra non-ignore condition is necessary because handle-normal-msg
;; ignores normal messages while recovering and waiting for sender j.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defthm imp-spec-equivalent-p-of-step-rcv-normal
  (implies
   (and
    (good-state-p imp-st)
    (good-spec-state-p spec-st)
    (imp-spec-equivalent-p imp-st spec-st)

    (memberp i (proc-ids imp-st))
    (memberp j (proc-ids imp-st))

    ;; Needed so that the channel j -> i is part of the equivalence
    ;; relation and the spec sees the same normal message.
    (memberp j (nbrs-from (g i (procs imp-st))))

    ;; This excludes the ignore-normal-msg case.
    (not
     (and
      (equal
       (proc-status (g i (procs imp-st)))
       :recovering)
      (memberp
       j
       (waiting-recovery-from (g i (procs imp-st))))))

    ;; The implementation receive consumes a normal message.
    (consp
     (channel-state j i (channels imp-st)))

    (equal
     (msg-type
      (get-msg-from-channel j i (channels imp-st)))
     :normal))

   (imp-spec-equivalent-p
    (step-rcv imp-st i j)
    (spec-step-rcv spec-st i j)))

  :hints
  (("Goal"
    :in-theory
    (disable
     good-state-p
     good-spec-state-p
     good-proc-p
     good-spec-proc-p
     step-rcv
     handle-normal-msg
     handle-normal-msg-core
     update-proc-for-normal-msg-core
     spec-step-rcv
     get-msg-from-channel
     remove-message-from-channel
     record-msg-in-snapshots
     imp-spec-channels-equivalent-p-aux
     procs-equivalent-p))))

