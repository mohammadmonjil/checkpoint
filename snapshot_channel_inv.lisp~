;; Following are cut-phase consistency predicate
;; To prove our one step preservation of the
;; main invariant, we need well-formedness of
;; the state w.r.t. to the marker algorithm
;; We have two conditions for now
;; 1. If j is pre-cut, then channel j->i must
;; remain open
;; 2. If marker is in the channel
;;    then j is post-cut and the channel is open
;;

(defun target-channel-not-closed-p
    (j i m)
  (if (cm-cut-not-taken-p m i)
      t
    (memberp
     j
     (cm-waiting-marker-for m i))))


(defun one-channel-cut-phase-consistent-p
    (j i m imp-st)
  (let* ((j-pre-cut-p
          (cm-cut-not-taken-p m j))

         (channel-open-p
          (target-channel-not-closed-p
           j
           i
           m))

         (marker-present-p
          (marker-for-sid-in-channel-p
           (cm-sid m)
           (channel-state
            j
            i
            (channels imp-st)))))

    (and
     ;; I cannot close j -> i before J sends its marker.
     (implies
      j-pre-cut-p
      channel-open-p)

     ;; The marker is in transit exactly after J cuts and
     ;; before I closes this channel.
     (equal
      marker-present-p
      (and
       (not j-pre-cut-p)
       channel-open-p)))))


;; Reconstruct the execution containing exactly the inputs that
;; have been classified as before-cut in M.
(defun before-cut-state-from-meta
    (imp-st-start m)
  (run-imp
   imp-st-start
   (cm-before-cut-input-sequence m)))





;; No implementation transition changes the outgoing-neighbor
;; topology of any process.
(defthm nbrs-to-of-system-step
  (equal
   (nbrs-to
    (g i
       (procs
        (system-step st input))))

   (nbrs-to
    (g i
       (procs st))))

  :hints
  (("Goal"
    :cases
    ((equal i (pid input))))))


(defthm nbrs-to-of-run-imp
  (equal
   (nbrs-to
    (g i
       (procs
        (run-imp st inputs))))

   (nbrs-to
    (g i
       (procs st))))

  :hints
  (("Goal"
    :induct
    (run-imp st inputs))))

;; History-based one-step preservation of the channel-snapshot
;; invariant for the incoming channel INCOMING-NBR -> I.

;;This lemma is needed to derive, if one process belongs to cut-not-taken-list
;; and the other does not, then they are not equal

(defthm memberp-and-not-memberp-implies-not-equal
  (implies
   (and
    (memberp k xs)
    (not
     (memberp j xs)))
   (not
    (equal k j)))

  :rule-classes
  ((:rewrite
    :match-free :all)))


;; channel between j-> i is unchanged by send-compute-message
;; on process k if k is different than j. As msg is appended to
;; all channels from k-> outgoing nbrs, so channels in j->i is
;; unchanged even if i belongs to outgoing nbrs
(defthm channel-state-of-send-compute-message-different-source
  (implies
   (not
    (equal k j))

   (equal
    (channel-state
     j
     i
     (send-compute-message
      local-state
      k
      nbrs
      channels))

    (channel-state
     j
     i
     channels)))

  :hints
  (("Goal"
    :induct
    (send-compute-message
     local-state
     k
     nbrs
     channels))))


;; A normal computation by K does not change the normal-message
;; prefix of channel J -> I preceding TARGET-SID's marker.
;;
;; If K differs from J, the channel is unchanged.  If K equals J,
;; any new messages are appended after the marker already present
;; on J -> I.


;; Appending a message cannot remove a target marker that is
;; already present in the channel.
(defthm marker-for-sid-in-channel-p-of-snoc-when-present
  (implies
   (marker-for-sid-in-channel-p
    target-sid
    channel)

   (marker-for-sid-in-channel-p
    target-sid
    (snoc channel msg))))


  ;; If the target marker is already present, appending a message
;; cannot change the channel prefix preceding that marker.
(defthm channel-before-target-marker-of-snoc-when-marker-present
  (implies
   (marker-for-sid-in-channel-p
    target-sid
    channel)

   (equal
    (channel-before-target-marker
     target-sid
     (snoc channel msg))

    (channel-before-target-marker
     target-sid
     channel))))


(defthm normal-msgs-before-target-marker-of-snoc-when-marker-present
  (implies
   (marker-for-sid-in-channel-p
    target-sid
    channel)

   (equal
    (project-channel-msgs-to-spec
     (channel-before-target-marker
      target-sid
      (snoc channel msg)))

    (project-channel-msgs-to-spec
     (channel-before-target-marker
      target-sid
      channel)))))


(defthm
  normal-msgs-before-target-marker-of-send-compute-message

  (implies
   (and
    (not
     (equal i k))

    (marker-for-sid-in-channel-p
     target-sid
     (channel-state
      j
      i
      channels)))

   (equal

    (project-channel-msgs-to-spec
     (channel-before-target-marker
      target-sid
      (channel-state
       j
       i
       (send-compute-message
        local-state
        k
        nbrs
        channels))))
    (project-channel-msgs-to-spec
     (channel-before-target-marker
      target-sid
      (channel-state
       j
       i
       channels)))))

  :hints
  (("Goal"
    :cases
    ((equal j k)))))




;; A normal computation cannot introduce a target marker.
;; Therefore, if the target marker is absent before the send,
;; CHANNEL-BEFORE-TARGET-MARKER returns the entire channel after
;; the send.

;; Appending a compute message preserves whether the target
;; marker is present in the channel.
(defthm
  marker-for-sid-in-channel-p-of-snoc-create-compute-message

  (equal
   (marker-for-sid-in-channel-p
    target-sid
    (snoc
     channel
     (create-compute-message
      local-state
      nbr)))

   (marker-for-sid-in-channel-p
    target-sid
    channel)))

(defthm
  normal-projection-of-channel-before-target-marker-after-send-when-absent

  (implies
   (and
    (equal
     (ttype input)
     :normal)

    (not
     (marker-for-sid-in-channel-p
      target-sid
      (channel-state
       j
       i
       channels))))

   (equal
    (project-channel-msgs-to-spec
     (channel-before-target-marker
      target-sid
      (channel-state
       j
       i
       (send-compute-message
        local-state
        (pid input)
        nbrs
        channels))))

    (project-channel-msgs-to-spec
     (channel-state
      j
      i
      (send-compute-message
       local-state
       (pid input)
       nbrs
       channels)))))

  :hints
  (("Goal"
    :cases
    ((equal j (pid input))))))



(defthm
  project-channel-before-target-marker-when-marker-not-present

  (implies
   (not
    (marker-for-sid-in-channel-p
     target-sid
     channel))

   (equal
    (project-channel-msgs-to-spec
     (channel-before-target-marker
      target-sid
      channel))

    (project-channel-msgs-to-spec
     channel))))


;; If two executions agree on K's local state and outgoing
;; topology, and the projected contents of J -> I are equal,
;; then K's normal computation preserves that equality.


(defun matching-send-compute-message-induct
    (local-state k nbrs channels-1 channels-2)
  (declare (irrelevant k channels-1 channels-2))
  (if (endp nbrs)
      t
    (let ((dst
           (first nbrs)))
      (if (message-to-send?
           local-state
           dst)

          ;; Send branch: update both channel tables.
          (let* ((msg
                  (create-compute-message
                   local-state
                   dst))

                 (channels-1-next
                  (>channel
                   k dst
                   (snoc
                    (channel-state k dst channels-1)
                    msg)
                   channels-1))

                 (channels-2-next
                  (>channel
                   k dst
                   (snoc
                    (channel-state k dst channels-2)
                    msg)
                   channels-2)))

            (matching-send-compute-message-induct
             local-state
             k
             (rest nbrs)
             channels-1-next
             channels-2-next))

        ;; No-send branch: leave both channel tables unchanged.
        (matching-send-compute-message-induct
         local-state
         k
         (rest nbrs)
         channels-1
         channels-2)))))



;; Appending a normal message appends that message to the
;; normal-message projection.
(defthm project-channel-msgs-to-spec-of-snoc-normal
  (implies
   (equal (msg-type msg) :normal)
   (equal
    (project-channel-msgs-to-spec
     (snoc channel msg))
    (snoc
     (project-channel-msgs-to-spec channel)
     msg)))
  :hints
  (("Goal"
    :induct (snoc channel msg))))


;; Appending a protocol message does not change the
;; normal-message projection.
(defthm project-channel-msgs-to-spec-of-snoc-non-normal
  (implies
   (not (equal (msg-type msg) :normal))
   (equal
    (project-channel-msgs-to-spec
     (snoc channel msg))
    (project-channel-msgs-to-spec channel)))
  :hints
  (("Goal"
    :induct (snoc channel msg))))


(defthm
  project-channel-msgs-to-spec-of-matching-send-compute-message-same-data

  (implies
   (equal
    (project-channel-msgs-to-spec
     (channel-state j i channels-1))

    (project-channel-msgs-to-spec
     (channel-state j i channels-2)))

   (equal
    (project-channel-msgs-to-spec
     (channel-state
      j i
      (send-compute-message
       local-state
       k
       nbrs
       channels-1)))

    (project-channel-msgs-to-spec
     (channel-state
      j i
      (send-compute-message
       local-state
       k
       nbrs
       channels-2)))))

  ;; Rewrite the complete equality proposition to T instead of
  ;; rewriting one projected channel expression into the other.
  :rule-classes
  ((:rewrite
    :corollary
    (implies
     (equal
      (project-channel-msgs-to-spec
       (channel-state j i channels-1))

      (project-channel-msgs-to-spec
       (channel-state j i channels-2)))

     (iff
      (equal
       (project-channel-msgs-to-spec
        (channel-state
         j i
         (send-compute-message
          local-state
          k
          nbrs
          channels-1)))

       (project-channel-msgs-to-spec
        (channel-state
         j i
         (send-compute-message
          local-state
          k
          nbrs
          channels-2))))
      t))))

  :hints
  (("Goal"
    :induct
    (matching-send-compute-message-induct
     local-state
     k
     nbrs
     channels-1
     channels-2))))


;; Extract local-state agreement for any process K that occurs in
;; IDS and has not yet taken its cut.
;; needed to apply send-compute-msg preservation of channel equality

(defthm local-state-equal-of-uncut-process
  (implies
   (and
    (before-imp-state-agree-aux-p
     ids
     m
     imp-st
     before-st)

    (memberp k ids)

    (cm-cut-not-taken-p m k))

   (equal
    (local-state
     (g k (procs imp-st)))

    (local-state
     (g k (procs before-st))))))

;;We also need incoming-nbr is a member of process-ds




;; Lastly, we need equal nbrs-to for both states
;; which can be dervied from
;; A process that has not taken its cut has the same outgoing
;; neighbor list in the implementation and before-cut states.
(defthm nbrs-to-equal-of-uncut-process
  (implies
   (and
    (before-imp-state-agree-aux-p
     ids
     m
     imp-st
     before-st)

    (memberp k ids)

    (cm-cut-not-taken-p m k))

   (equal
    (nbrs-to
     (g k (procs imp-st)))

    (nbrs-to
     (g k (procs before-st))))))


;; Now we get a subgoal which says, if B = R++C, there B is normal projection
;; of channel j->i in before-st, R is recorded msg in snapshot and
;; C is normal projection of  channel j->i in imp-st, then if R is
;; unchanged then B' = R ++ C' where ' denotes one application of
;; send-compute-msg.

;; Appending a message after an existing prefix is equivalent to
;; appending the message to the suffix.
(defthm snoc-of-append
  (equal
   (snoc (append prefix channel) msg)
   (append prefix
           (snoc channel msg)))
  :hints
  (("Goal"
    :induct (append prefix channel))))


;; One matching normal-message channel update preserves the fixed
;; PREFIX relation between the selected channel projections.
(defthm projected-channel-prefix-relation-of-matching-send-update
  (implies
   (and
    (equal (msg-type msg) :normal)

    (equal
     (project-channel-msgs-to-spec
      (channel-state j i channels-1))

     (append
      prefix
      (project-channel-msgs-to-spec
       (channel-state j i channels-2)))))

   (equal
    (project-channel-msgs-to-spec
     (channel-state
      j
      i
      (>channel
       k
       dst
       (snoc
        (channel-state k dst channels-1)
        msg)
       channels-1)))

    (append
     prefix
     (project-channel-msgs-to-spec
      (channel-state
       j
       i
       (>channel
        k
        dst
        (snoc
         (channel-state k dst channels-2)
         msg)
        channels-2))))))

  :hints
  (("Goal"
    :cases
    ((equal j k)
     (equal i dst)))))


;; Applying the same SEND-COMPUTE-MESSAGE traversal preserves the
;; fixed PREFIX relation between the selected channel projections.
(defthm
  project-channel-msgs-to-spec-of-matching-send-compute-message-with-prefix

  (implies
   (equal
    (project-channel-msgs-to-spec
     (channel-state j i channels-1))

    (append
     prefix
     (project-channel-msgs-to-spec
      (channel-state j i channels-2))))

   (equal
    (project-channel-msgs-to-spec
     (channel-state
      j
      i
      (send-compute-message
       local-state
       k
       nbrs
       channels-1)))

    (append
     prefix
     (project-channel-msgs-to-spec
      (channel-state
       j
       i
       (send-compute-message
        local-state
        k
        nbrs
        channels-2))))))

  ;; Use the equality as a complete proposition instead of using
  ;; it as a substitution rule between its two sides.
  :rule-classes
  ((:rewrite
    :corollary
    (implies
     (equal
      (project-channel-msgs-to-spec
       (channel-state j i channels-1))

      (append
       prefix
       (project-channel-msgs-to-spec
        (channel-state j i channels-2))))

     (iff
      (equal
       (project-channel-msgs-to-spec
        (channel-state
         j
         i
         (send-compute-message
          local-state
          k
          nbrs
          channels-1)))

       (append
        prefix
        (project-channel-msgs-to-spec
         (channel-state
          j
          i
          (send-compute-message
           local-state
           k
           nbrs
           channels-2)))))
