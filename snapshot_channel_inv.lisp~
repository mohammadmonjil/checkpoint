  target-sid-absent-from-before-state-when-process-uncut

  (implies
   (and
    (cut-meta-imp-consistent-p
     m
     imp-st)

    (before-imp-state-agree-aux-p
     (proc-ids imp-st)
     m
     imp-st
     before-st)

    (memberp i
             (proc-ids imp-st))

    (memberp i
             (cm-cut-not-taken m)))

   (not
    (memberp
     (cm-sid m)
     (snapshot-ids
      (g i (procs before-st))))))

  :rule-classes
  ((:rewrite
    :match-free :all))

  :hints
  (("Goal"
    :use
    ((:instance
      cut-meta-imp-consistent-p-implies-target-sid-absent-when-uncut
      (m m)
      (imp-st imp-st)
      (i i))

     (:instance
      snapshot-ids-equal-when-before-imp-state-agree-and-process-uncut
      (ids (proc-ids imp-st))
      (m m)
      (imp-st imp-st)
      (before-st before-st)
      (i i))))))



;; Updating WAITING-MARKER-FROM and AFTER-CUT-INPUT-SEQUENCE
;; does not change CUT-NOT-TAKEN.
(defthm
  cm-cut-not-taken-of-waiting-marker-from-and-after-cut-input-sequence-update

  (equal
   (cm-cut-not-taken
    (s :waiting-marker-from
       waiting-marker-from
       (s :after-cut-input-sequence
          after-cut-input-sequence
          m)))

   (cm-cut-not-taken m)))



;; In the recursive consistency relation, a process that has
;; taken the target cut must contain the target SID.
(defthm
  cut-meta-imp-procs-consistent-p-implies-target-sid-present-when-cut-taken

  (implies
   (and
    (cut-meta-imp-procs-consistent-p
     ids
     target-sid
     m
     procs)

    (memberp i ids)

    (not
     (memberp i
              (cm-cut-not-taken m))))

   (memberp
    target-sid
    (snapshot-ids
     (g i procs)))))


;; Top-level version that directly matches the hypotheses produced
