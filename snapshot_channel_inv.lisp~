(defthm
  one-channel-snapshot-invariant-p-preserved-by-one-step-history

  (let ((before-st-cur
         (before-cut-state-from-meta
          imp-st-start
          m-cur)))

    (implies
     (and
      ;; Current implementation and reconstructed before-cut
      ;; states are structurally well formed.
      (good-state-p
       imp-st-cur)

      (good-state-p
       before-st-cur)

      ;; Recovery behavior is excluded.
      (recovery-free-state-p
       imp-st-cur)

      (recovery-free-state-p
       before-st-cur)

      (cl-checkpoint-body-input-p
       input)

      ;; INPUT is legal in the current original execution.
      (legal-inputp
       imp-st-cur
       input)

      ;; M-CUR is well formed and describes the target
      ;; checkpoint in IMP-ST-CUR.
      (good-cut-meta-p
       m-cur)

      (cut-meta-imp-consistent-p
       m-cur
       imp-st-cur)

      ;; INCOMING-NBR -> I is an incoming channel of I.
      (memberp
       i
       (proc-ids imp-st-cur))

      (memberp
       incoming-nbr
       (nbrs-from
        (g i (procs imp-st-cur))))

      ;; The current implementation and reconstructed before-cut
      ;; state agree for every process that has not taken its cut.
      (before-imp-state-agree-p
       m-cur
       imp-st-cur
       before-st-cur)

      ;; The target-marker location agrees with the current phase
      ;; of channel INCOMING-NBR -> I.
      (one-channel-cut-phase-consistent-p
       incoming-nbr
       i
       m-cur
       imp-st-cur)

      ;; The conservation equation holds in the current states.
      (one-channel-snapshot-invariant-p
       incoming-nbr
       i
       m-cur
       imp-st-cur
       before-st-cur))

     (let* (;; Process INPUT through the cut scanner first.
            ;; If INPUT is before-cut, it is appended to the
            ;; before-cut sequence before the cut status changes.
            (m-next
             (process-cut-step
              input
              imp-st-cur
              m-cur))

            ;; The original implementation always executes INPUT.
            (imp-st-next
             (system-step
              imp-st-cur
              input))

            ;; Reconstruct the new before-cut execution from the
            ;; complete before-cut sequence stored in M-NEXT.
            (before-st-next
             (before-cut-state-from-meta
              imp-st-start
              m-next)))

       (one-channel-snapshot-invariant-p
        incoming-nbr
        i
        m-next
        imp-st-next
        before-st-next))))
  :hints (("Goal"
	   :do-not-induct t
	   :cases ((not (equal i (pid input))))
	   :in-theory
	   (disable good-state-p
		    good-cut-meta-p
		    get-msg-from-channel
		    remove-message-from-channel
		    cut-meta-imp-consistent-p
		    recovery-free-state-p
					; run-imp
		    cm-cut-not-taken
		    make-snapshot-entry
		    UPDATE-PROC-FOR-FIRST-MARKER-MSG
		    UPDATE-PROC-FOR-NON-FIRST-MARKER-MSG
		    UPDATE-PROC-FOR-NORMAL-MSG-CORE))))
