(in-package "ACL2")

(include-book "local_swap")


;; our target is to prove, correctness of stored msgs in snapshots. So we to prove
;; an invariant of the following form:
;; 

;; INCOMING-NBR is the source of the channel, and I is its
;; destination.  Thus, the channel direction is:
;;
;;                    INCOMING-NBR -> I


;; Recognize a marker for TARGET-SID.
(defun target-marker-msg-p
    (target-sid msg)
  (and
   (equal (msg-type msg) :marker)
   (equal (sid msg) target-sid)))


;; Return the raw channel prefix strictly preceding the target
;; marker.  If the target marker is absent, return the entire
;; channel.
(defun channel-before-target-marker
    (target-sid channel)
  (declare
   (xargs :measure (acl2-count channel)))
  (if (endp channel)
      nil
    (let ((msg (first channel)))
      (if (target-marker-msg-p target-sid msg)
          nil
        (cons
         msg
         (channel-before-target-marker
          target-sid
          (rest channel)))))))


;; Return the normal messages preceding the target marker.
;; Protocol messages in the prefix are removed.
(defun normal-msgs-before-target-marker
    (target-sid channel)
  (project-channel-msgs-to-spec
   (channel-before-target-marker
    target-sid
    channel)))


;; Return the normal-message projection of the incoming channel
;; from INCOMING-NBR to process I.
(defun normal-channel-msgs
    (incoming-nbr i st)
  (project-channel-msgs-to-spec
   (channel-state
    incoming-nbr
    i
    (channels st))))


;; Return the messages already recorded by process I for its
;; incoming channel from INCOMING-NBR.  Before I takes its cut,
;; the recorded list is empty.
(defun recorded-channel-msgs
    (incoming-nbr i m imp-st)
  (if (cm-cut-not-taken-p m i)
      nil
    (g incoming-nbr
       (snapshot-channel-snapshots
        (snapshot-entry
         (cm-sid m)
         (g i (procs imp-st)))))))


;; Return the normal messages that belong to the channel snapshot
;; but have not yet been recorded by process I.
;;
;; While the channel is open, these are the normal messages before
;; the target marker.  After I receives the marker from INCOMING-NBR,
;; no messages remain to be recorded for this channel.
(defun remaining-before-cut-channel-msgs
    (incoming-nbr i m imp-st)
  (if (or
       (cm-cut-not-taken-p m i)
       (memberp
        incoming-nbr
        (cm-waiting-marker-for m i)))
      (normal-msgs-before-target-marker
       (cm-sid m)
       (channel-state
        incoming-nbr
        i
        (channels imp-st)))
    nil))


;; The normal messages in the before-cut channel consist of the
;; messages already recorded by I followed by the messages that
;; remain to be recorded.
(defun one-channel-snapshot-invariant-p
    (incoming-nbr i m imp-st before-cut-st)
  (equal
   (normal-channel-msgs
    incoming-nbr
    i
    before-cut-st)

   (append
    (recorded-channel-msgs
     incoming-nbr
     i
     m
     imp-st)

    (remaining-before-cut-channel-msgs
     incoming-nbr
     i
     m
     imp-st))))


;; Check the channel invariant for every incoming neighbor in
;; INCOMING-NBRS.
(defun incoming-channels-snapshot-invariant-p
    (incoming-nbrs i m imp-st before-cut-st)
  (declare
   (xargs :measure (acl2-count incoming-nbrs)))
  (if (endp incoming-nbrs)
      t
    (and
     (one-channel-snapshot-invariant-p
      (first incoming-nbrs)
      i
      m
      imp-st
      before-cut-st)

     (incoming-channels-snapshot-invariant-p
      (rest incoming-nbrs)
      i
      m
      imp-st
      before-cut-st))))


;; Check the channel invariant for every incoming channel of
;; process I.  The local-state invariant is handled separately.
(defun one-process-channel-snapshot-invariant-p
    (i m imp-st before-cut-st)
  (incoming-channels-snapshot-invariant-p
   (nbrs-from
    (g i (procs imp-st)))
   i
   m
   imp-st
   before-cut-st))





;; Return the raw channel prefix through and including the
;; first target marker.
(defun channel-through-target-marker
    (target-sid channel)
  (declare
   (xargs :measure (acl2-count channel)))
  (if (endp channel)
      nil
    (let ((msg (first channel)))
      (if (target-marker-msg-p target-sid msg)
          (list msg)
        (cons
         msg
         (channel-through-target-marker
          target-sid
          (rest channel)))))))


;; While I is pre-cut, relate one incoming channel in the
;; implementation and before-cut states.

;; For a process i, if i has taken cut then there is no comparison
;; If i is pre-cut, then if the incoming-nbr
;; is also pre-cut, then imp-channel and the before-channel is equal
;; if the nbr is post-cut, then before-channel is equal to the
;; imp-channel until and including the target-marker. Any msg
;; sent after the target marker will not be in the before-channel

(defun one-uncut-incoming-channel-agrees-p
    (incoming-nbr i m imp-st before-st)
  (if (cm-cut-not-taken-p m i)
      (let ((imp-channel
             (channel-state
              incoming-nbr
              i
              (channels imp-st)))

            (before-channel
             (channel-state
              incoming-nbr
              i
              (channels before-st))))

        (if (cm-cut-not-taken-p m incoming-nbr)

            ;; Neither endpoint has taken its cut, so both
            ;; executions have the same raw channel.
            (equal
             before-channel
             imp-channel)

          ;; INCOMING-NBR has cut, but I has not.  The before
          ;; execution contains the channel only through the
          ;; target marker.  Post-cut messages may follow the
          ;; marker only in the implementation channel.
          (equal
           before-channel
           (channel-through-target-marker
            (cm-sid m)
            imp-channel))))
    t))


;; Lift the raw-channel relation over every incoming channel
;; of process I.
(defun uncut-incoming-channels-agree-p
    (incoming-nbrs i m imp-st before-st)
  (declare
   (xargs :measure (acl2-count incoming-nbrs)))
  (if (endp incoming-nbrs)
      t
    (and
     (one-uncut-incoming-channel-agrees-p
      (first incoming-nbrs)
      i
      m
      imp-st
      before-st)

     (uncut-incoming-channels-agree-p
      (rest incoming-nbrs)
      i
      m
      imp-st
      before-st))))



;; if i is pre-cut in implementation (and in meta-data m which tracks the implementation),
;; then they should be procs-equivalent-p and checkpoint-control

(defun one-uncut-process-agrees-p
    (i m imp-st before-st)
  (if (cm-cut-not-taken-p m i)
      (and
       ;; Local state and topology.
       (proc-equivalent-p
        (g i (procs imp-st))
        (g i (procs before-st)))

       ;; Counter and snapshot-id list, but not snapshot contents.
       (equal
        (cl-checkpoint-control-view
         (list i)
         (procs imp-st))
        (cl-checkpoint-control-view
         (list i)
         (procs before-st))))
    t))


(defun before-imp-state-agree-aux-p
    (ids m imp-st before-st)
  (declare
   (xargs :measure (acl2-count ids)))
  (if (endp ids)
      t
    (let* ((i
            (first ids))

           (imp-p
            (g i (procs imp-st))))

      (and
       (one-uncut-process-agrees-p
        i m imp-st before-st)

       (uncut-incoming-channels-agree-p
        (nbrs-from imp-p)
        i m imp-st before-st)

       (before-imp-state-agree-aux-p
        (rest ids)
        m imp-st before-st)))))


;; We have to later derive preservation
;; of this invariant
(defun before-imp-state-agree-p
    (m imp-st before-st)
  (and
   (equal
    (proc-ids imp-st)
    (proc-ids before-st))

   (before-imp-state-agree-aux-p
    (proc-ids imp-st)
    m imp-st before-st)))




