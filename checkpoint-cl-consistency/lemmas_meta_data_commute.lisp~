     (equal
      (msg-type
       (get-msg-from-channel
        (sender input-post)
        (pid input-post)
        (channels st)))
      :marker)))

   (equal
    (get-msg-from-channel
     (sender input-post)
     (pid input-post)
     (channels
      (system-step st input-pre)))

    (get-msg-from-channel
     (sender input-post)
     (pid input-post)
     (channels st))))

  :hints
  (("Goal"
    :use
    ((:instance
      cl-post-pre-receive-receive-preserves-get-msg
      (input-1 input-post)
      (input-2 input-pre)))

    :in-theory
    (disable
     cut-markers-in-transit-p
     cut-meta-imp-consistent-p
     good-cut-meta-p
     good-state-p
     recovery-free-state-p
