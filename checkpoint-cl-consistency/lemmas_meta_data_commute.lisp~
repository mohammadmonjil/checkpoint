   (and
    (cut-markers-in-transit-p m st)
    (cut-meta-imp-consistent-p m st)
    (good-cut-meta-p m)
    (good-state-p st)
    (recovery-free-state-p st)

    (legal-input-sequencep
     st
     (list input-post input-pre))

    (equal (ttype input-post) :receive)
    (equal (ttype input-pre) :receive)

    ;; INPUT-POST is already post-cut.
    (not
     (cm-cut-not-taken-p
      m
      (pid input-post)))

    ;; INPUT-PRE is still pre-cut.
    (cm-cut-not-taken-p
     m
     (pid input-pre))

    ;; Processing INPUT-POST does not consume a marker.
