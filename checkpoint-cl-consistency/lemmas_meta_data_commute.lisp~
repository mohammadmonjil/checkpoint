(defthm
  get-msg-unchanged-by-normal-receive-at-different-dst

  (implies
   (and
    ;; INPUT performs a receive.
    (equal
     (ttype input)
     :receive)

    ;; The message consumed by INPUT is an ordinary message.
    (equal
     (msg-type
      (current-msg-for-receive
       input st))
     :normal)

    ;; The observed channel belongs to another destination.
    (not
     (equal
      dst
      (pid input))))

   (equal
    (get-msg-from-channel
     src
     dst
     (channels
      (system-step st input)))

    (get-msg-from-channel
     src
     dst
     (channels st))))

  :hints
  (("Goal"
    :in-theory
     (
      disable
      get-msg-from-channel
      remove-message-from-channel
      record-msg-in-snapshots
      cl-two-imp-inputs-swappable-p
      cl-post-pre-swap-start-p
      legal-inputp
      legal-input-sequencep
      no-recovery-step-p
      recovery-free-state-p
      good-state-p
      good-cut-meta-p
      cut-markers-in-transit-p
      cut-meta-imp-consistent-p))))



(defthm
  cl-swappable-receive-receive-preserves-get-messages

  (implies
   (and
    (cl-two-imp-inputs-swappable-p
     st input-1 input-2)

    (equal
     (ttype input-1)
     :receive)

    (equal
     (ttype input-2)
     :receive))

   (and
    ;; INPUT-2 does not change the channel message seen by INPUT-1.
    (equal
     (get-msg-from-channel
      (sender input-1)
      (pid input-1)
      (channels
       (system-step st input-2)))

     (get-msg-from-channel
      (sender input-1)
      (pid input-1)
      (channels st)))

    ;; INPUT-1 does not change the channel message seen by INPUT-2.
    (equal
     (get-msg-from-channel
      (sender input-2)
      (pid input-2)
      (channels
       (system-step st input-1)))

     (get-msg-from-channel
      (sender input-2)
      (pid input-2)
      (channels st)))))

  :hints
  (("Goal"
    :in-theory
    (disable
     get-msg-from-channel
     remove-message-from-channel
     record-msg-in-snapshots))))




