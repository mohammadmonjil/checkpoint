;; ------------------------------------------------------------
;; Checkpoint control state that is hidden by REP2 but can
;; affect future checkpoint-body execution.
;;
;; COUNTER:
;;   determines the SID created by :START-CHECKPOINT.
;;
;; SNAPSHOT-IDS:
;;   determines whether a received marker is handled as the
;;   first marker or a later marker.
;; ------------------------------------------------------------

(defun cl-checkpoint-control-equivalent-p
    (ids procs-1 procs-2)

  (declare
   (xargs :measure (acl2-count ids)))

  (if (endp ids)
      t

    (let* ((i  (first ids))
           (p1 (g i procs-1))
           (p2 (g i procs-2)))

      (and
       (equal
        (counter p1)
        (counter p2))

       (equal
        (snapshot-ids p1)
        (snapshot-ids p2))

       (cl-checkpoint-control-equivalent-p
        (rest ids)
        procs-1
        procs-2)))))




;; ------------------------------------------------------------
;; A NOP input does not change the implementation process table.
;; ------------------------------------------------------------

(defthm procs-of-system-step-when-nop
  (implies
   (equal
    (ttype input)
    :nop)

   (equal
    (procs
     (system-step st input))

    (procs st))))


;; ------------------------------------------------------------
;; A NOP step leaves the entire implementation state unchanged.
;; ------------------------------------------------------------

(defthm system-step-when-nop
  (implies
   (equal
    (ttype input)
    :nop)

   (equal
    (system-step st input)
    st)))


;; ------------------------------------------------------------
;; SEND-COMPUTE-MESSAGE only appends normal messages.
;; Therefore it cannot replace the head of an already nonempty
;; channel by a recovery message.
