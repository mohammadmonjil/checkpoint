(defun cl-procs-equivalent-p
    (ids procs-1 procs-2)

  (declare
   (xargs :measure (acl2-count ids)))

  (if (endp ids)

      t

    (let* ((i  (first ids))
           (p1 (g i procs-1))
           (p2 (g i procs-2)))

      (and

       (equal
        (g :local-state p1)
        (g :local-state p2))

       (equal
        (g :nbrs-to p1)
        (g :nbrs-to p2))

       (equal
        (g :nbrs-from p1)
        (g :nbrs-from p2))

       (cl-procs-equivalent-p
        (rest ids)
        procs-1
        procs-2)))))


(defun cl-state-equivalent-p
    (st-1 st-2)

  (and

   (equal
    (g :proc-ids st-1)
    (g :proc-ids st-2))

   (equal
    (g :channels st-1)
    (g :channels st-2))

   (cl-procs-equivalent-p
    (g :proc-ids st-1)
    (g :procs st-1)
    (g :procs st-2))

   (cl-checkpoint-control-equivalent-p
    (g :proc-ids st-1)
    (g :procs st-1)
    (g :procs st-2))))


