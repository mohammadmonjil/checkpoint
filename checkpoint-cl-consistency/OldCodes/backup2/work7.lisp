(defthm
  recovery-free-implies-send-compute-head-not-recovery

  (implies
   (and
    (recovery-free-state-p st)

    (memberp src
             (proc-ids st))

    (memberp dst
             (proc-ids st))

    (consp
     (channel-state
      src
      dst
      (channels st))))

   (not
    (equal
     (msg-type
      (get-msg-from-channel
       src
       dst
       (send-compute-message
        local-state
        i
        nbrs
        (channels st))))
     :recovery)))

  :hints
  (("Goal"
    :in-theory
    (disable
     get-msg-from-channel))))


