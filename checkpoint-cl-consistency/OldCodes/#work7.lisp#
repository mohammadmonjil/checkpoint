;;
;; This is exactly the easy branch needed later when
;;
;;     SENDER(INPUT-J) != PID(INPUT-I).
;; ------------------------------------------------------------

(defthm
  channel-state-after-normal-step-when-src-different

  (implies
   (and
    (equal
     (ttype input)
     :normal)

    (not
     (equal
      src
      (pid input))))

