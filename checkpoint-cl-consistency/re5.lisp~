(defthm append-append-singleton
  (equal
   (append
    (append xs (list x))
    ys)
   (append
    xs
    (cons x ys))))

(defthm append-nil-when-true-listp
  (implies
   (true-listp xs)
   (equal
    (append xs nil)
    xs)))

(defthm true-listp-of-append-singleton
  (true-listp
   (append xs (list x))))

(defthm true-listp-of-cm-before-cut-input-sequence-of-process-cut-step
