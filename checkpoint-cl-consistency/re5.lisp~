     st m input-1 input-2))
   (cl-checkpoint-control-equivalent-p
    (proc-ids st)
    (procs
     (system-step
      (system-step st input-1)
      input-2))
    (procs
     (system-step
      (system-step st input-2)
      input-1))))
  :hints
  (("Goal"
    :use
    ((:instance
